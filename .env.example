# ============================================================
# FinScope 环境配置文件
# 金融研报智能分析系统
#
# 使用方式:
#   1. cp .env.example .env
#   2. 配置 LLM_PROVIDER 和对应的 API Key
#   3. streamlit run frontend/app.py
# ============================================================

# ---- LLM 提供商 (必填) ----
# 可选: deepseek / openai / ollama
LLM_PROVIDER=deepseek

# ---- DeepSeek 配置 ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI 配置 ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Ollama 配置 ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ---- 金融数据源 ----
# Tushare API token (从 https://tushare.pro 获取)
TUSHARE_TOKEN=your-tushare-token-here
# Tushare 优先于 AkShare
TUSHARE_PRIORITY=true

# ---- SQLite 状态持久化 ----
SQLITE_PATH=./data/sqlite/agent_state.db

# ---- Agent 执行控制 ----
MAX_AGENT_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=120
SINGLE_AGENT_MAX_CALLS=3

# ---- LLM 调用参数 ----
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---- 日志级别 ----
LOG_LEVEL=INFO
