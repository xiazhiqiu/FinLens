# ============================================================
# FinScope 环境配置文件
# 金融研报智能分析系统
#
# 使用方式:
#   1. cp .env.example .env
#   2. 配置 LLM_PROVIDER 和对应的 API Key
#   3. streamlit run frontend/app.py
# ============================================================

# ---- LLM 提供商 (必填) ----
# 可选: deepseek / openai / ollama
LLM_PROVIDER=deepseek

# ---- DeepSeek 配置 ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI 配置 ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Ollama 配置 ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ---- 金融数据源 ----
# Tushare API token (从 https://tushare.pro 获取)
TUSHARE_TOKEN=your-tushare-token-here
# Tushare 优先于 AkShare
TUSHARE_PRIORITY=true

# ---- SQLite 状态持久化 ----
SQLITE_PATH=./data/sqlite/agent_state.db

# ---- Agent 执行控制 ----
MAX_AGENT_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=120
SINGLE_AGENT_MAX_CALLS=3

# ---- LLM 调用参数 ----
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---- 日志级别 ----
LOG_LEVEL=INFO

# ============================================================
# [企业级] 安全配置
# ============================================================

# JWT 密钥 (生产环境必须修改)
JWT_SECRET=your-jwt-secret-change-in-production

# AES 加密密钥 (生产环境必须修改，32字符)
AES_ENCRYPTION_KEY=your-aes-encryption-key-32b

# 是否启用 API Key 认证
API_KEY_ENABLED=false

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间（分钟）
LOCKOUT_DURATION_MINUTES=30

# ============================================================
# [企业级] 合规配置
# ============================================================

# 严格模式（任何违规都拒绝）
COMPLIANCE_STRICT_MODE=false

# 启用内容过滤
ENABLE_CONTENT_FILTER=true

# 启用信息隔离墙
ENABLE_CHINESE_WALL=true

# 报告需要审批
REPORT_APPROVAL_REQUIRED=true

# 审计日志保留天数（7年=2555天）
AUDIT_RETENTION_DAYS=2555

# ============================================================
# [企业级] 审计配置
# ============================================================

# 启用控制台审计日志
AUDIT_ENABLE_CONSOLE=true

# 启用文件审计日志
AUDIT_ENABLE_FILE=true

# 启用数据库审计日志
AUDIT_ENABLE_DATABASE=false

# 审计日志级别
AUDIT_LOG_LEVEL=INFO

# 启用防篡改存储
ENABLE_IMMUTABLE_STORE=true

# ============================================================
# [企业级] 部署配置
# ============================================================

# 部署环境
DEPLOY_ENV=development

# 服务端口
SERVICE_PORT=8501

# 数据库路径
DATABASE_PATH=./data/sqlite

# 审计日志路径
AUDIT_LOG_PATH=./data/audit_logs
